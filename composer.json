{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "codearachnid/check-commerce-laravel-sdk",
    "description": "A modern PHP SDK for the Check Commerce (OBP Link) API \u2014 ACH, RTP, paper check and IAT payments, stored consumers, recurring subscriptions, hosted payment pages, batch processing and merchant boarding.",
    "keywords": [
        "laravel",
        "codearachnid",
        "check-commerce-laravel-sdk"
    ],
    "homepage": "https://github.com/codearachnid/check-commerce-laravel-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Timothy Wood",
            "email": "codearachnid@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "CheckCommerceLaravelSDK\\CheckCommerceLaravelSDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CheckCommerceLaravelSDK\\CheckCommerceLaravelSDK\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "CheckCommerceLaravelSDK\\CheckCommerceLaravelSDK\\CheckCommerceLaravelSDKServiceProvider"
            ],
            "aliases": {
                "CheckCommerceLaravelSDK": "CheckCommerceLaravelSDK\\CheckCommerceLaravelSDK\\Facades\\CheckCommerceLaravelSDK"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
